# ==============================================================================
# rove — single source of truth for ALL services (api / web / mysql / redis)
# Decision: monorepo + one root .env (deviates from DEV_SPEC §14) — see docs/adr
# Copy to .env and fill in.  docker compose reads this file automatically.
# ==============================================================================

# ------------------------------------------------------------------ mode
#
# THREE independent switches. They used to be two, one of which meant both
# things at once, and "is any of this real?" had no answer as a result.
#
# 1. NEXT_PUBLIC_DATA_MODE — where the data lives. This is "mock mode".
#      mock = nothing leaves the browser. localStorage only, nothing is saved
#             for real, no API or database required. What UAT runs on.
#      live = every write goes through the Go API and lands in MySQL. Real.
NEXT_PUBLIC_DATA_MODE=mock
#
# 2. STUB_PROVIDERS — whether the THIRD PARTIES behind a live API are real.
#    This is NOT a mock database: every write still lands in MySQL either way.
#    true = Anthropic, Google, FX, weather, storage and e-mail are replaced by
#           deterministic stand-ins. Never honoured in production.
#    (MOCK_MODE is the old name for this and is still read.)
STUB_PROVIDERS=true
#
# 3. DEV_LOGIN — whether POST /api/v1/auth/demo exists: a sign-in with no
#    provider behind it, for a machine with no OAuth credentials. Used to be
#    implied by MOCK_MODE, which meant turning the stubs off locked everyone
#    out. Never honoured in production. Pair with NEXT_PUBLIC_DEV_LOGIN below.
DEV_LOGIN=true

# ------------------------------------------------------------------ core
ENV=development
COMMIT=local
# Set to "info" to log every SQL statement (noisy — off by default).
GORM_LOG=

# ------------------------------------------------------------------ api
# Which half of the product this process is (Phase 3 — INFRA):
#   all    = one binary serving HTTP and running AI drafts (the default)
#   api    = serves HTTP, hands drafts to Redis for a worker to pick up
#   worker = drains the AI queue, serves nothing
# Locally: `docker compose --profile worker up -d` runs the split.
ROVE_ROLE=all

# Port INSIDE the container. Keep at 5000 (DEV_SPEC §8.1).
API_PORT=5000
# Port on YOUR machine. Defaults to 5050 because macOS AirPlay Receiver holds
# 5000 — set it back to 5000 if you have AirPlay Receiver turned off.
API_EXPOSED_PORT=5050
# Public URL of the API (deeplink /go/:id, oauth callback, invite url)
APP_BASE_URL=http://localhost:5050
# Public URL of the web app (CORS allowlist, invite links, share links)
WEB_BASE_URL=http://localhost:3000
# CHANGE THIS. openssl rand -hex 32
JWT_SECRET_KEY=dev_only_insecure_change_me_0000000000000000000000000000000000000000
ADMIN_EMAILS=

# ------------------------------------------------------------------ mysql
# host = docker service name. use 127.0.0.1 only when running the api on the host.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=rove
MYSQL_PASSWORD=rove_dev_password
MYSQL_DATABASE=rovedb
MYSQL_ROOT_PASSWORD=root_dev_password
# host port mapping for GUI clients (TablePlus/DBeaver)
MYSQL_EXPOSED_PORT=3306

# ------------------------------------------------------------------ redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_EXPOSED_PORT=6379

# ------------------------------------------------------------------ ai (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL_PLANNER=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MAX_TOKENS=8000
AI_DAILY_COST_CAP_USD=20

# --------------------------------------------------- brand assets (design-time)
# Black Forest Labs (FLUX). Only `scripts/gen-brand-assets.mjs` reads this — it
# regenerates the illustrations in apps/web/public. Nothing at runtime needs it,
# so leave it blank unless you are re-cutting artwork.
BFL_API_KEY=

# ------------------------------------------------------------------ google
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------ line
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=

# ------------------------------------------------------------------ external data
OPEN_METEO_BASE=https://api.open-meteo.com
FX_API_URL=
FX_API_KEY=

# ------------------------------------------------------------------ cloudflare r2
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_EXPORT_BUCKET=
R2_IMAGE_BUCKET=
R2_DOCUMENT_BUCKET=
R2_PHOTO_BUCKET=

# ------------------------------------------------------------------ affiliate (D0.6)
AFFILIATE_AGODA_ID=
AFFILIATE_BOOKING_AID=
AFFILIATE_KLOOK_AID=
AFFILIATE_KKDAY_ID=
AFFILIATE_RENTALCARS_ID=
AFFILIATE_AIRALO_ID=
# Shared secret for partner postbacks (A12.6) — leave empty to keep the webhook off
AFFILIATE_WEBHOOK_SECRET=

# Agent lead handoff (A12.12). Both empty = the request is still stored and
# the screen says nobody was messaged, rather than pretending.
AGENT_LEAD_EMAIL=
AGENT_LEAD_LINE_USER_ID=
AGENT_LEAD_PARTNER=

# ------------------------------------------------------------------ web (Next.js)
# Port INSIDE the container.
WEB_PORT=3000
# Port on YOUR machine — change it if something else already owns 3000.
WEB_EXPOSED_PORT=3000
# browser-side: must be reachable from the user's browser (host-mapped port)
NEXT_PUBLIC_API_URL=http://localhost:5050
NEXT_PUBLIC_APP_URL=http://localhost:3000
# server-side (SSR inside the container): uses the docker network
API_INTERNAL_URL=http://api:5000
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# BRAND — DEV_SPEC §15 (decided: ROVE). Never hardcode the name in the app.
NEXT_PUBLIC_BRAND_NAME=ROVE
AUTH_COOKIE_NAME=rove_token
AUTH_COOKIE_DOMAIN=localhost
# Web half of DEV_LOGIN above: shows the demo button on /admin/login (never on
# the public /login screen). Both sides must be on, and the route refuses in
# production. Leave it blank once real OAuth credentials are in place — the
# staff door still works, it just uses the same OAuth as everyone else.
NEXT_PUBLIC_DEV_LOGIN=
